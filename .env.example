# ── The Odds API ──────────────────────────────────────────────────────────
ODDS_API_KEY=sua_chave_aqui

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nba_scout
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nba_scout

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Observabilidade ───────────────────────────────────────────────────────
SENTRY_DSN=
# Amostragem de traces do Sentry (0.0 = só erros; ex.: 0.1 = 10% das requests)
SENTRY_TRACES_SAMPLE_RATE=0.0
# Grafana (compose.observability.yml) — troque em produção
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Data warehouse ────────────────────────────────────────────────────────
# Janela deslizante: máx. de gamelogs por jogador (o sync poda os mais antigos).
WAREHOUSE_MAX_GAMES_PER_PLAYER=100
# Hora UTC do sync incremental do DW (roda antes do cron de análise).
CRON_WAREHOUSE_SYNC_HOUR=13

# ── Line history ──────────────────────────────────────────────────────────
# Retenção (dias) da série intraday de linhas, podada no cron diário de análise.
# 0 desliga a poda. A odd/linha do momento da análise fica em analyzed_props,
# então podar aqui não perde dado de backtest.
LINE_HISTORY_RETENTION_DAYS=30

# ── Proxy (para geoblock do stats.nba.com em servidor cloud) ──────────────
# HTTPS_PROXY=http://proxy:port
